# Supabase > Connect > Transaction pooler (port 6543) : utilisé par l'application
DATABASE_URL=
# Supabase > Connect > Session pooler (port 5432) : utilisé par drizzle-kit
DATABASE_URL_MIGRATE=
# console.anthropic.com > API Keys : utilisé pour la sélection (Haiku) et les brèves (Haiku)
ANTHROPIC_API_KEY=
# Secret des routes /api/* (en-tête Authorization: Bearer ...). Vercel Cron l'envoie automatiquement.
# Générer : openssl rand -hex 32
CRON_SECRET=
